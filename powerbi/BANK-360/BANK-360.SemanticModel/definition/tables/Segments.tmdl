table Segments

	column age_band
		dataType: string
		summarizeBy: none
		sourceColumn: age_band

	column credit_limit_band
		dataType: string
		summarizeBy: none
		sourceColumn: credit_limit_band

	column september_status
		dataType: int64
		summarizeBy: none
		sourceColumn: september_status

	column client_count
		dataType: int64
		summarizeBy: none
		sourceColumn: client_count

	column default_count
		dataType: int64
		summarizeBy: none
		sourceColumn: default_count

	column delayed_count
		dataType: int64
		summarizeBy: none
		sourceColumn: delayed_count

	column total_credit_limit_ntd
		dataType: int64
		summarizeBy: none
		sourceColumn: total_credit_limit_ntd

	column total_age_years
		dataType: int64
		summarizeBy: none
		sourceColumn: total_age_years

	partition Segments = m
		mode: import
		source =
			let
			    Source = Csv.Document(Web.Contents("https://raw.githubusercontent.com", [RelativePath="sogoyou8/BANK-360/main/powerbi/data/uci350_segments.csv"]), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    Promoted = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(Promoted,{{"age_band", type text}, {"credit_limit_band", type text}, {"september_status", Int64.Type}, {"client_count", Int64.Type}, {"default_count", Int64.Type}, {"delayed_count", Int64.Type}, {"total_credit_limit_ntd", Int64.Type}, {"total_age_years", Int64.Type}},"en-US")
			in
			    Typed

	annotation PBI_ResultType = Table
